<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Hypermedia Events Demo"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <pageSize
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                        fieldLabel="Page size"
                        min="1"
                        name="./pageSize"
                        value="6"/>
                    <paginationType
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldLabel="Pagination type"
                        name="./paginationType"
                        value="pages">
                        <items jcr:primaryType="nt:unstructured">
                            <pages
                                jcr:primaryType="nt:unstructured"
                                text="Page links"
                                value="pages"/>
                            <loadMore
                                jcr:primaryType="nt:unstructured"
                                text="Load more"
                                value="loadMore"/>
                            <none
                                jcr:primaryType="nt:unstructured"
                                text="None"
                                value="none"/>
                        </items>
                    </paginationType>
                    <filters
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                        composite="true"
                        fieldDescription="Add one dropdown per tag-based event filter. Each filter uses the selected tags as its options."
                        fieldLabel="Filters">
                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            name="./filters">
                            <items jcr:primaryType="nt:unstructured">
                                <name
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Parameter name"
                                    name="./name"
                                    required="true"/>
                                <label
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="Label"
                                    name="./label"/>
                                <allText
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldLabel="All option text"
                                    name="./allText"/>
                                <tags
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="cq/gui/components/coral/common/form/tagfield"
                                    fieldLabel="Filter tags"
                                    multiple="true"
                                    name="./tags"
                                    rootPath="/content/cq:tags"/>
                            </items>
                        </field>
                    </filters>
                </items>
            </column>
        </items>
    </content>
</jcr:root>

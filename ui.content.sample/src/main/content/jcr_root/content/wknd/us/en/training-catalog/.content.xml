<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/wknd/settings/wcm/templates/content-page-template"
        jcr:description="Demo page for the hypermedia training catalog with multi-select filters and service-driven data."
        jcr:primaryType="cq:PageContent"
        jcr:title="Training Catalog"
        sling:resourceType="wknd/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="wknd/components/container">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="wknd/components/container"
                layout="responsiveGrid">
                <title
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Training Catalog"
                    sling:resourceType="wknd/components/title"/>
                <text
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="wknd/components/text"
                    text="&lt;p>This page demonstrates a training catalog powered by a mocked third-party service. All filter options are generated dynamically at render time. Use the checkboxes to filter by training type, product, or language. The search field filters across titles and descriptions.&lt;/p>&#xa;"
                    textIsRich="true"/>
                <training_catalog
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="wknd/components/hypermedia-training-catalog"
                    title="Training Catalog"/>
            </container>
        </root>
    </jcr:content>
</jcr:root>
